//@version=5
indicator("Malkan 7-Star PRD Screener [Daily]", overlay=true, max_labels_count=50)

// --- INPUTS ---
grp_trend = "Star 1: Trend Alignment"
len_ema50 = input.int(50, "EMA 50 Len", group=grp_trend)
len_ema200 = input.int(200, "EMA 200 Len", group=grp_trend)
st_len = input.int(10, "Supertrend Len", group=grp_trend)
st_mult = input.float(3.0, "Supertrend Mult", group=grp_trend)

grp_prd = "Star 2: PRD Momentum (ROC)"
roc_len = input.int(9, "ROC Length", group=grp_prd)
roc_thresh = input.float(0, "Min ROC % (0=Off)", group=grp_prd)

grp_vol = "Star 4: Volume"
vol_mult = input.float(1.5, "Vol > Avg Mult", group=grp_vol)
vol_len = input.int(20, "Vol Avg Len", group=grp_vol)

grp_rs = "Star 5: Relative Strength"
bench = input.symbol("NSE:NIFTY", "Benchmark", group=grp_rs)
rs_len = input.int(20, "RS Lookback", group=grp_rs)

grp_rr = "Star 6: Risk:Reward"
rr_min = input.float(2.5, "Min R:R", group=grp_rr)
target_lookback = input.int(20, "Target Lookback (Swing High)", group=grp_rr)

grp_sec = "Star 7: Sector"
sec_sym = input.symbol("NSE:CNXENERGY", "Sector Index (change per stock)", group=grp_sec)

// --- INDICATORS ---
// Trend
ema50 = ta.ema(close, len_ema50)
ema200 = ta.ema(close, len_ema200)
[st_line, st_dir] = ta.supertrend(st_mult, st_len)
trend_up = close > ema50 and ema50 > ema200
st_green = st_dir < 0
star1 = trend_up and st_green

// PRD Momentum (ROC)
roc_val = ta.roc(close, roc_len)
roc_accel = roc_val > roc_val[1]
roc_ok = roc_val > roc_thresh
star2 = roc_ok and roc_accel and (roc_val > 0)

// Reversal candle (Hammer / Bullish Engulfing / Piercing)
is_hammer = (close > open) and (high - close) < (close - open) * 0.5 and (open - low) > (close - open) * 2.0
is_engulf = (close[1] < open[1]) and (close > open) and (close >= open[1]) and (open <= close[1])
is_pierce = (close[1] < open[1]) and (close > open) and (open < low[1]) and (close > (open[1] + close[1]) / 2) and (close < open[1])
reversal_candle = is_hammer or is_engulf or is_pierce

// Support check (near EMA50 or Supertrend line)
near_ema50 = math.abs(close - ema50) / close < 0.015
near_st = math.abs(close - st_line) / close < 0.015
at_support = near_ema50 or near_st

star3 = reversal_candle and at_support

// Volume
vol_avg = ta.sma(volume, vol_len)
star4 = volume > vol_avg * vol_mult

// Relative strength
bench_close = request.security(bench, "D", close[1], lookahead=barmerge.lookahead_on)
bench_roc = ta.roc(bench_close, rs_len)
stock_roc = ta.roc(close, rs_len)
star5 = stock_roc > bench_roc

// Risk:Reward
entry = close
sl = low
target = ta.highest(high, target_lookback)
rr = (target - entry) / (entry - sl)
star6 = (entry > sl) and (target > entry) and (rr >= rr_min)

// Sector
sec_close = request.security(sec_sym, "D", close[1], lookahead=barmerge.lookahead_on)
sec_ema50 = request.security(sec_sym, "D", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)
sec_roc = request.security(sec_sym, "D", ta.roc(close, 9)[1], lookahead=barmerge.lookahead_on)
star7 = (sec_close > sec_ema50) and (sec_roc > 0)

// --- SCORING ---
score = (star1 ? 1 : 0) + (star2 ? 1 : 0) + (star3 ? 1 : 0) + (star4 ? 1 : 0) + (star5 ? 1 : 0) + (star6 ? 1 : 0) + (star7 ? 1 : 0)

// --- VISUALS ---
plot(ema50, "EMA 50", color=color.blue, linewidth=2)
plot(ema200, "EMA 200", color=color.red, linewidth=2)
plot(st_line, "Supertrend", color=st_green ? color.green : color.red, linewidth=2)

if star3 and (score >= 6)
    label.new(bar_index, low,
      text="Score " + str.tostring(score) + "/7\nRR:" + str.tostring(rr, "#.##") + "\nSL:" + str.tostring(sl, "#.##") + "\nTG:" + str.tostring(target, "#.##"),
      color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

// Dashboard table
var table dash = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 80), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "STAR", bgcolor=color.gray, text_color=color.white)
    table.cell(dash, 1, 0, "STATUS", bgcolor=color.gray, text_color=color.white)

    var bool[] stars_arr = array.new_bool(7)
    array.set(stars_arr, 0, star1)
    array.set(stars_arr, 1, star2)
    array.set(stars_arr, 2, star3)
    array.set(stars_arr, 3, star4)
    array.set(stars_arr, 4, star5)
    array.set(stars_arr, 5, star6)
    array.set(stars_arr, 6, star7)

    var string[] names = array.from("1 Trend+ST", "2 ROC Accel", "3 Rev Candle", "4 Volume", "5 RS vs Nifty", "6 R:R > 2.5", "7 Sector")

    for i = 0 to 6
        cell_ok = array.get(stars_arr, i)
        c = cell_ok ? color.green : color.red
        table.cell(dash, 0, i + 1, array.get(names, i), text_color=color.white)
        table.cell(dash, 1, i + 1, cell_ok ? "YES" : "NO", bgcolor=c, text_color=color.white)

    table.cell(dash, 0, 8, "TOTAL SCORE", bgcolor=color.gray, text_color=color.white)
    sc_color = score >= 7 ? color.lime : (score >= 6 ? color.yellow : color.red)
    table.cell(dash, 1, 8, str.tostring(score) + " / 7", bgcolor=sc_color, text_color=color.black)

// Alert condition
alertcondition(star3 and score >= 6, title="7-Star PRD Setup (Score 6+)", message="Setup: {{ticker}} Score: {{score}}/7 RR: {{rr}}")
